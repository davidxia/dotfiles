[".goenv"]
    type = "git-repo"
    url = "https://github.com/go-nv/goenv.git"
    refreshPeriod = "168h"
    pull.args = ["--ff-only"]

{{/* Linux tools that aren't packaged for the distro. Each tracks the latest
     GitHub release; chezmoi re-checks at most once per refreshPeriod. */ -}}
{{ if and (eq .chezmoi.os "linux") (eq .chezmoi.arch "amd64") -}}
[".local/bin/fish"]
    type = "archive-file"
    url = {{ gitHubLatestReleaseAssetURL "fish-shell/fish-shell" "fish-*-linux-x86_64.tar.xz" | quote }}
    path = "fish"
    executable = true
    refreshPeriod = "168h"

[".local/bin/dust"]
    type = "archive-file"
    url = {{ gitHubLatestReleaseAssetURL "bootandy/dust" "dust-*-x86_64-unknown-linux-musl.tar.gz" | quote }}
    path = "dust"
    stripComponents = 1
    executable = true
    refreshPeriod = "168h"
{{- if eq .osid "linux-ubuntu" }}

[".local/bin/difft"]
    type = "archive-file"
    url = {{ gitHubLatestReleaseAssetURL "Wilfred/difftastic" "difft-*-x86_64-unknown-linux-musl.tar.gz" | quote }}
    path = "difft"
    executable = true
    refreshPeriod = "168h"

[".local/bin/yq"]
    type = "file"
    url = {{ gitHubLatestReleaseAssetURL "mikefarah/yq" "yq_linux_amd64" | quote }}
    executable = true
    refreshPeriod = "168h"
{{- end }}
{{ end -}}
