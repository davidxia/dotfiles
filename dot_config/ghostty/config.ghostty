# Install Ghostty's terminfo on SSH hosts that lack it, so programs like less
# don't warn that the terminal is not fully functional.
shell-integration-features = ssh-terminfo

# Solarized, following macOS light/dark appearance.
theme = light:Solarized Light Readable,dark:Solarized Dark Readable
# Darken or lighten any color too close to the background, such as Solarized
# yellow and cyan on the light background.
minimum-contrast = 3
# Dim text (e.g. Claude Code's secondary text) defaults to 50% opacity, which
# is hard to read on Solarized backgrounds.
faint-opacity = 0.8
