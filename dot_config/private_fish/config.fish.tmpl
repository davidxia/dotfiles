# fish 4's solarized theme has light and dark variants and switches with the
# terminal's color theme.
fish_config theme choose solarized

# PATH directories from .chezmoidata/shell.yaml in the chezmoi source, shared
# with ~/.config/shell/env.sh. fish_add_path skips directories that don't
# exist. --move puts the prepended ones back in front in their listed order.
# The directories are unquoted so an unset variable adds nothing:
# fish_add_path treats an empty string as the current directory.
fish_add_path --path --move
{{- range .shell.path.prepend }}
{{-   if eq (get . "os" | default $.chezmoi.os) $.chezmoi.os }} {{ .dir }}{{ end }}
{{- end }}
fish_add_path --path --append
{{- range .shell.path.append }}
{{-   if eq (get . "os" | default $.chezmoi.os) $.chezmoi.os }} {{ .dir }}{{ end }}
{{- end }}

if test -d $HOME/.goenv
  set -gx GOENV_ROOT $HOME/.goenv
end

# Sourcing nvm.sh through bass is slow, so only login and interactive shells put
# nvm's Node on PATH. load_nvm also switches Node when the directory changes.
if status --is-login; or status --is-interactive
  if test -s $HOME/.nvm/nvm.sh; and functions -q bass
    load_nvm > /dev/stderr
  end
end

# needed to use gpg-agent for SSH
if status --is-interactive
  set -x GPG_TTY (tty)
{{- if eq .chezmoi.os "darwin" }}
  set -x SSH_AUTH_SOCK (gpgconf --list-dirs agent-ssh-socket)
  # Connecting starts gpg-agent if it isn't running.
  gpg-connect-agent --quiet /bye >/dev/null
{{- end }}
{{- if eq .chezmoi.os "linux" }}

  # Keep a fixed symlink so tmux panes always find the current SSH agent.
  # On each new SSH connection, SSH_AUTH_SOCK points to a fresh socket path;
  # we update the symlink and then always export the fixed path so existing
  # tmux windows (which already have the symlink path set) pick it up too.
  set -l fixed_sock $HOME/.ssh/ssh_auth_sock
  if set -q SSH_AUTH_SOCK; and test "$SSH_AUTH_SOCK" != "$fixed_sock"
    ln -sf $SSH_AUTH_SOCK $fixed_sock
  end
  if test -L $fixed_sock
    set -x SSH_AUTH_SOCK $fixed_sock
  end
{{- end }}

  # difftastic reads DFT_BACKGROUND. Keep it matching the terminal's theme, and
  # assume light until the terminal reports one.
  set -q DFT_BACKGROUND; or set -gx DFT_BACKGROUND light
  function __sync_dft_background --on-variable fish_terminal_color_theme
    if contains -- "$fish_terminal_color_theme" light dark
      set -gx DFT_BACKGROUND $fish_terminal_color_theme
    end
  end

  if type -q starship
    starship init fish | source
  end
end

if type -q direnv
  direnv hook fish | source
end
