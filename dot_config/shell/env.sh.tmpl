# Environment for bash and sh, sourced by ~/.profile and ~/.bashrc. Commands run
# over SSH (`ssh host cmd`) read only ~/.bashrc, so everything here must be
# POSIX sh, quick, and safe to source more than once. ~/.config/fish/config.fish
# sets up the same environment for fish.

_path_prepend() {
  case ":$PATH:" in
    *:"$1":*) ;;
    *) [ -d "$1" ] && PATH="$1:$PATH" ;;
  esac
}

_path_append() {
  case ":$PATH:" in
    *:"$1":*) ;;
    *) [ -d "$1" ] && PATH="$PATH:$1" ;;
  esac
}

{{ if eq .chezmoi.os "darwin" -}}
_path_append "$HOME/.docker/bin"

{{ end -}}
{{ if eq .chezmoi.os "linux" -}}
# snapd only adds its bin dir for login shells.
_path_append /var/lib/snapd/snap/bin

{{ end -}}
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"
[ -f "$HOME/.local/bin/env" ] && . "$HOME/.local/bin/env"

if [ -d "$HOME/.goenv" ]; then
  export GOENV_ROOT="$HOME/.goenv"
  _path_prepend "$GOENV_ROOT/bin"
  _path_prepend "$GOENV_ROOT/shims"
fi

_path_prepend "$HOME/google-cloud-sdk/bin"

export PATH
unset -f _path_prepend _path_append
