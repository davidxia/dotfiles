# Environment for bash and sh, sourced by ~/.profile and ~/.bashrc. Commands run
# over SSH (`ssh host cmd`) read only ~/.bashrc, so everything here must be
# POSIX sh, quick, and safe to source more than once. ~/.config/fish/config.fish
# sets up the same environment for fish, and both take PATH directories from
# .chezmoidata/shell.yaml in the chezmoi source.

_path_prepend() {
  case ":$PATH:" in
    *:"$1":*) ;;
    *) [ -d "$1" ] && PATH="$1:$PATH" ;;
  esac
}

_path_append() {
  case ":$PATH:" in
    *:"$1":*) ;;
    *) [ -d "$1" ] && PATH="$PATH:$1" ;;
  esac
}

{{ range .shell.path.prepend | reverse -}}
{{   if eq (get . "os" | default $.chezmoi.os) $.chezmoi.os -}}
_path_prepend "{{ .dir }}"
{{   end -}}
{{ end -}}
{{ range .shell.path.append -}}
{{   if eq (get . "os" | default $.chezmoi.os) $.chezmoi.os -}}
_path_append "{{ .dir }}"
{{   end -}}
{{ end }}
[ -d "$HOME/.goenv" ] && export GOENV_ROOT="$HOME/.goenv"

export PATH
unset -f _path_prepend _path_append
