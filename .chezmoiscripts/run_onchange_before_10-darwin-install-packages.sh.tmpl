{{ if eq .chezmoi.os "darwin" -}}
#!/bin/bash
set -euo pipefail

brew bundle install --no-upgrade --file=/dev/stdin <<EOF

{{ range includeTemplate ".chezmoitemplates/tools-for" (dict "data" . "platform" "darwin" "installer" "brew") | splitList "\n" | compact -}}
brew {{ (index $.packages.tools .).brew | quote }}
{{ end -}}

{{ range .packages.casks -}}
cask {{ . | quote }}
{{ end -}}

EOF
{{ end -}}
