{{ if eq .osid "linux-ubuntu" -}}
#!/bin/bash
# One-time shell setup. Every step is guarded so re-running is a no-op.
set -euo pipefail

{{ if hasKey .packages.tools "fish" -}}
fish_path="$(command -v fish)"
if [ "$(getent passwd "$(whoami)" | cut -d: -f7)" != "$fish_path" ]; then
  sudo chsh -s "$fish_path" "$(whoami)"
fi
{{ end -}}

{{ end -}}
