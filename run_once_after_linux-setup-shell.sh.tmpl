{{ if eq .osid "linux-ubuntu" -}}
#!/bin/bash
# One-time shell setup. Every step is guarded so re-running is a no-op.
set -euo pipefail

{{ if has "fish" .packages.ubuntu.apt -}}
fish_path="$(command -v fish)"
if [ "$(getent passwd "$(whoami)" | cut -d: -f7)" != "$fish_path" ]; then
  sudo chsh -s "$fish_path" "$(whoami)"
fi
{{ end -}}

if ! command -v uv >/dev/null && [ ! -x ~/.local/bin/uv ]; then
  curl -LsSf https://astral.sh/uv/install.sh | sh
fi
{{ if has "fish" .packages.ubuntu.apt -}}
mkdir -p ~/.config/fish/completions && echo 'uv generate-shell-completion fish | source' > ~/.config/fish/completions/uv.fish
{{ end -}}
{{ end -}}
