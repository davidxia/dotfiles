{{- $osid := .chezmoi.os -}}
{{- if hasKey .chezmoi.osRelease "id" -}}
{{-   $osid = printf "%s-%s" .chezmoi.os .chezmoi.osRelease.id -}}
{{- end -}}

{{- $workemail := promptStringOnce . "workemail" "Work email" -}}
gitHub:
  # Cache GitHub API lookups for .chezmoiexternal.toml.tmpl so every chezmoi
  # command doesn't spend anonymous API rate limit.
  refreshPeriod: 12h

cd:
  command: fish

edit:
  command: vim

data:
  email: david@davidxia.com
  workemail: {{ $workemail | quote }}
  editor: vim
  osid: {{ $osid | quote }}
