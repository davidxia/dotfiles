{{ if eq .osid "linux-ubuntu" -}}
#!/bin/bash
set -euo pipefail

sudo apt update

{{ range .packages.ubuntu.apt -}}
sudo apt install --yes --no-install-recommends {{ . | quote }}
{{ end -}}

{{ range $channel, $packages := .packages.ubuntu.snaps -}}
{{ range $packages -}}
sudo snap install {{ . | quote }} --{{ $channel }}
{{ end -}}
{{ end -}}
{{ end -}}
