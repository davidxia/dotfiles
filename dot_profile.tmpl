[ -f "$HOME/.config/shell/env.sh" ] && . "$HOME/.config/shell/env.sh"

# Sourcing nvm.sh is slow, so only login shells put nvm's default Node on PATH.
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"

# Bash login shells reach this file through ~/.bash_profile and don't read
# ~/.bashrc on their own. Keep this last: on Linux, ~/.bashrc execs fish in
# interactive shells.
if [ -n "${BASH_VERSION:-}" ] && [ -f "$HOME/.bashrc" ]; then
  . "$HOME/.bashrc"
fi
